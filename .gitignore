# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local Claude Code dev-server configs
.claude/

# Generated by @bacons/apple-targets during prebuild, not authored. EAS runs
# its own prebuild, so committing these only risks them going stale against
# app.json's icon and the target config.
/targets/*/Assets.xcassets

# Header prototypes are regenerated by scripts/marketing/header-proto.mjs in
# seconds; 3840x1646 PNGs are ~3MB each and four of the five are thrown away
# the moment one is picked. The script is the artefact, not the renders.
screenshots-header/header-*.png
