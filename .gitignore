# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local Claude Code dev-server configs
.claude/

# Generated by @bacons/apple-targets during prebuild, not authored. EAS runs
# its own prebuild, so committing these only risks them going stale against
# app.json's icon and the target config.
/targets/*/Assets.xcassets

# The product page header's DELIVERABLE (product-page-header.png) is committed,
# like every other listing asset — it is the file Apple approves, and if the
# builder ever drifts, the committed image is what was actually uploaded. The
# -ref copy is the unflattened screenshot, kept only as a yardstick, so it is
# not. NOTE this pattern deliberately matches *-ref.png and not *.png: the
# deliverable is itself a PNG since 09.10, when the Header slot turned out to
# refuse JPEG despite Apple's own spec listing it.
screenshots-header/*-ref.png
