{
  "expo": {
    "name": "CruiseFM",
    "slug": "CruiseFM",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cruisefm",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/95c6799b-4a44-45f4-89b2-81962388e88e"
    },
    "runtimeVersion": "1.3.0",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.driftlore.CruiseFM",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "Cruise FM plays your own Apple Music playlists inside its driving visuals. It only ever plays what you choose.",
        "NSPhotoLibraryAddUsageDescription": "Cruise FM saves the share card you make of your drive to your photo library, so you can post it wherever you like."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0E14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.driftlore.CruiseFM"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "cruise-fm",
          "project": "react-native"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cruise FM saves the share card you make of your drive to your photo library, so you can post it wherever you like.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cruise FM lets you choose one photo of your own as the background for a station you create. It is copied into the app and never leaves your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95c6799b-4a44-45f4-89b2-81962388e88e"
      }
    }
  }
}
